# Revalidate page HTML and assets so an older app cannot keep requesting
# removed lazy-loaded chunks after a Pages deployment. ETags permit 304s.
/*
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://js.stripe.com; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.civicsign.co.uk https://unpkg.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://api.stripe.com; worker-src 'self' blob:; frame-src 'self' blob: https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
