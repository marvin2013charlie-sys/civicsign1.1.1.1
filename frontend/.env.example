# Optional — leave unset for local dev (setupProxy forwards /api to :8001).
# Set only when the frontend must call a different origin in production builds.
# REACT_APP_BACKEND_URL=https://api.example.com

# Canonical site URL for SEO meta tags, Open Graph and sitemap (production).
# REACT_APP_SITE_URL=https://www.civicsign.co.uk

# Private beta: show founder-led support banner in Settings → Help
# REACT_APP_PRIVATE_BETA=true

# Google Search Console — HTML tag verification content value
# REACT_APP_GOOGLE_SITE_VERIFICATION=your-verification-token

# Google Analytics 4 — measurement ID (G-XXXXXXXXXX). Loads only after cookie consent.
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Webpack health-check plugin (dev only)
# ENABLE_HEALTH_CHECK=true