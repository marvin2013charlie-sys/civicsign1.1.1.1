MONGO_URL=mongodb://localhost:27017
DB_NAME=civicsign
CORS_ORIGINS=http://localhost:3000

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string-minimum-32-chars
PLAN_ENCRYPTION_SECRET=change-me-to-another-random-hex-string

# Set DEV_MODE=true only in local development (exposes OTPs/codes in API responses)
DEV_MODE=false
# Set COOKIE_SECURE=false for local HTTP dev (default true)
COOKIE_SECURE=true
# Set TRUST_PROXY=true when behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Optional: seed demo + admin accounts on first startup (omit to skip seeding)
ADMIN_EMAIL=demo@example.com
ADMIN_PASSWORD=
INTERNAL_ADMIN_EMAIL=admin@example.com
INTERNAL_ADMIN_PASSWORD=

# --- Resend (transactional email) ---
# 1. Create API key: https://resend.com/api-keys  -> re_...
# 2. Verify your domain OR use onboarding@resend.dev for local tests only
# 3. Restart backend after saving
RESEND_API_KEY=
SENDER_EMAIL=noreply@civicsign.co.uk
SENDER_NAME=CivicSign
FRONTEND_URL=http://localhost:3000

# --- Stripe (billing) ---
# 1. Test keys: https://dashboard.stripe.com/test/apikeys
#    STRIPE_API_KEY=sk_test_...
# 2. Webhook secret (local): run `stripe listen --forward-to localhost:8001/api/webhook/stripe`
#    copy whsec_... from CLI output -> STRIPE_WEBHOOK_SECRET
# 3. Production webhook URL: https://api.civicsign.co.uk/api/webhook/stripe
#    events: checkout.session.completed
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Business plan fair-use (not literally infinite — protects infra; raise per contract in admin)
BUSINESS_FAIR_USE_MONTHLY=10000
ENVELOPE_HOURLY_BURST=100
BULK_SEND_MAX_ROWS=250
# ENTERPRISE_HOURLY_BURST=2000  # for enterprise_unlimited accounts

# Organisation shared pools (e.g. bank with many branch logins)
ORG_FAIR_USE_DEFAULT=50000
ORG_HOURLY_BURST=500

# AI features (document summary, field suggestions, assistant chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini